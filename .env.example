# ===== Discord =====
DISCORD_TOKEN=isi_token_bot
CLIENT_ID=isi_application_id_bot
# Isi GUILD_ID supaya slash command langsung muncul di server kamu (kosongkan = global, butuh waktu sampai 1 jam)
GUILD_ID=isi_id_server

# ===== Roblox Open Cloud =====
# Buat di https://create.roblox.com/dashboard/credentials -> API Keys
# SARAN: buat dari AKUN ALT yang TIDAK punya audio apa pun (lihat README)
ROBLOX_API_KEY=isi_api_key_open_cloud

# ===== Pengaturan (opsional) =====
# Maksimal ID per sekali cek
MAX_IDS=50
# Berapa ID dicek bersamaan (jangan terlalu besar, nanti kena rate limit Roblox)
CONCURRENCY=3
# Jeda antar pengecekan per member (detik). Member dengan izin Manage Server tidak kena cooldown.
COOLDOWN_SECONDS=20
# Hasil cek disimpan sementara (menit) supaya ID yang sama tidak dicek ulang
CACHE_MINUTES=30
# true = hasil hanya terlihat oleh yang mengecek, false = terlihat semua orang di channel
RESULT_EPHEMERAL=true

# Override base URL (opsional, kalau VPS susah konek ke Roblox dan pakai proxy/mirror sendiri)
# ROBLOX_ECONOMY_BASE=https://economy.roblox.com
# ROBLOX_OPENCLOUD_BASE=https://apis.roblox.com
